rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /punches/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /worklogs/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /violations/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /sheets/{sid} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
      match /customers/{cid} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }
      match /entries/{eid} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
      match /bills/{bid} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }
    }
    match /hisab/{document=**} {
      allow read, write: if isAdmin();
    }
    // ===== TOURS (Task 93, Boss 2026-10-28): tour paste + salesman hisab =====
    // NOTE: live rules staff-app repo se deploy hote hain (CI) — wahan open
    // hain; ye file dashboard-repo ka reference hai (agar kabhi yahan se
    // deploy ho to tours ke rules ye hone chahiye):
    //   - tour doc: sab logged-in read, admin write
    //   - hisab/{uid}: sab logged-in read (boss view), uid khud likhe,
    //     admin sab — delete sirf admin
    match /tours/{tourId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
      match /hisab/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
        allow delete: if isAdmin();
      }
    }
    // ===== TEMPORARY BRIDGES — Fix 3A + migration complete hone ke baad delete =====
    match /staff_users/{uid} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /customers/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /entries/{id} {
      allow read, create: if true;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /stars/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
